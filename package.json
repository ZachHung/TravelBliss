{
  "name": "travelbliss",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.12.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "start:dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preview:test": "vite preview --outDir ./generated/test",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm eslint && pnpm stylelint",
    "eslint": "eslint . --cache",
    "stylelint": "stylelint \"**/*.css\" --cache",
    "prettier": "prettier --check \"**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
    "format": "pnpm prettier:write && pnpm eslint --fix && pnpm stylelint --fix",
    "vitest": "CI=true vitest run",
    "vitest:watch": "CI=true vitest",
    "test": "CI=true pnpm typecheck && pnpm prettier && pnpm lint && pnpm vitest && pnpm build",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "prepare": "husky",
    "codegen": "graphql-codegen --config codegen.ts",
    "postinstall": "pnpm codegen"
  },
  "dependencies": {
    "@apollo/client": "^4.3.7",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@mantine/core": "^9.8.0",
    "@mantine/dates": "^9.8.0",
    "@mantine/form": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@tabler/icons-react": "^3.51.0",
    "dayjs": "^1.11.23",
    "graphql": "^16.15.0",
    "lodash": "^4.18.1",
    "mantine-form-zod-resolver": "^1.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.8",
    "@eslint/js": "^9.39.5",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/client-preset": "^4.8.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.19",
    "@storybook/blocks": "^8.6.14",
    "@storybook/preview-api": "^8.6.14",
    "@storybook/react": "^8.6.19",
    "@storybook/react-vite": "^8.6.19",
    "@storybook/test": "^8.6.15",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-mantine": "^4.0.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "storybook": "^8.6.19",
    "storybook-dark-mode": "^4.0.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
