{
  "name": "travelbliss",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:local": "test -f .env.local || { echo 'Create .env.local with the local docker values first (see .env.example).' >&2; exit 1; } && pnpm --filter @travelbliss/api docker:local:up -d --wait && NODE_ENV=local pnpm --filter @travelbliss/api migration:up && NODE_ENV=local turbo run dev",
    "dev:local:down": "pnpm --filter @travelbliss/api docker:local:down",
    "dev:stop": "pkill -f '[t]s-node-dev' ; kill $(lsof -ti :8000 -ti :5173) 2>/dev/null ; echo 'Dev servers on :8000 and :5173 stopped'",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run typecheck lint test build format:check knip --concurrency=1 --ui=stream",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md,yml,yaml}\"",
    "knip": "knip",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md,yml,yaml}\" && turbo run lint -- --fix",
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "e2e": "pnpm --filter @travelbliss/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-mantine": "^4.0.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "knip": "6.44.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "bcrypt",
      "esbuild"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --cache"
    ],
    "*.css": [
      "pnpm --filter @travelbliss/web exec stylelint --fix --cache",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
