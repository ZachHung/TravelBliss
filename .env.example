# Copy to the repo root as one file per environment (never commit them):
#   .env.local        local docker Postgres + Redis, used by `pnpm dev:local` and apps/api/infra/docker-compose.yml
#   .env.production   the VM's (ADR 0006): written there by Terraform, never on a developer's machine
#   .env.e2e          the one committed exception: dummy values for the throwaway stack `pnpm e2e` starts and removes
# The API loads only .env.${NODE_ENV}. Only VITE_* variables are exposed to the browser.
# The API refuses to start, and a deploy stops before migrating, while one it needs is unset: the list is in
# apps/api/src/config/env.ts, so a new required variable goes there as well as here.

# --- Docker compose ---
# Docker compose's own variable; only .env.e2e sets it, so its stack runs as a separate project beside dev's
COMPOSE_PROJECT_NAME=

# --- Web ---
# URL of the TravelBliss GraphQL API
VITE_GRAPHQL_URI=http://localhost:8000

# --- API ---
API_PORT=8000
# error | warn | info | debug. Defaults to info in production, debug elsewhere
API_LOG_LEVEL=
# Both are origins (https://host, no path or trailing slash), required in production.
# The web app's origin, elsewhere defaults to http://localhost:5173: CORS, and where linked sign-in returns to
API_CORS_ORIGIN=
# Where browsers reach the API, elsewhere defaults to http://localhost:${API_PORT}: providers redirect to
# ${API_PUBLIC_URL}/auth/<provider>/callback, which must match the URL registered with them
API_PUBLIC_URL=
# Not in any env file: the commit the image was built from, a build arg images.yml sets. GET /health reports it as
# `version`, "dev" when unset (#201)
GIT_SHA=

API_POSTGRES_HOST=localhost
API_POSTGRES_PORT=5432
# Required, as is API_REDIS_PASSWORD below: every stack's Postgres and Redis (infra/oracle/compose.backing-services.yml)
# refuse to start with one unset, rather than run with an empty password
API_POSTGRES_USER=
API_POSTGRES_PASSWORD=
API_POSTGRES_DB=
# true for hosted Postgres (e.g. Neon), false for local docker
API_POSTGRES_SSL=false

API_REDIS_URI=redis://default:<password>@localhost:6379
# Only read by docker compose (apps/api/infra): the local Redis host port (default 6379) and password (required; the
# same one goes in API_REDIS_URI)
API_REDIS_PORT=
API_REDIS_PASSWORD=

API_SALT_ROUND=10
# 32 characters, used for aes-256-cbc
API_ENCRYPTION_KEY=

API_SECRET_JWT=
API_JWT_EXPIRED=5minutes
API_SECRET_REFRESH=
# Idle timeout: a remembered session with no refresh for this long ends. Also the refresh cookie's lifetime.
API_REFRESH_EXPIRED=30d
# Absolute timeout: no session outlives this, counted from sign-in, however active
API_SESSION_MAX_AGE=90d
API_COOKIE_NAME=travelBliss

# Linked sign-in (docs/linked-sign-in-setup.md). A provider is offered only when both of its values are set.
# NODE_ENV=local (pnpm dev:local) and NODE_ENV=e2e (pnpm e2e) also offer a fake "Dev" provider that needs neither.
API_GOOGLE_CLIENT_ID=
API_GOOGLE_CLIENT_SECRET=
API_FACEBOOK_APP_ID=
API_FACEBOOK_APP_SECRET=
