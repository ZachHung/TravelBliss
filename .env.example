# Copy to .env.development (or .env.local to override everything) at the repo root.
# Both apps read these files with Vite's precedence:
#   .env.[mode].local > .env.[mode] > .env.local > .env
# Only VITE_* variables are exposed to the browser.

# --- Web ---
# URL of the TravelBliss GraphQL API
VITE_GRAPHQL_URI=http://localhost:8000

# --- API ---
API_PORT=8000
# Optional, defaults to http://localhost:5173
API_CORS_ORIGIN=

API_POSTGRES_HOST=localhost
API_POSTGRES_PORT=5432
API_POSTGRES_USER=
API_POSTGRES_PASSWORD=
API_POSTGRES_DB=
# true for hosted Postgres (e.g. Neon), false for local docker
API_POSTGRES_SSL=false

API_REDIS_URI=redis://default:<password>@localhost:6379
# Only read by docker compose (apps/api/infra) to set the local Redis password
API_REDIS_PASSWORD=

API_SALT_ROUND=10
# 32 characters, used for aes-256-cbc
API_ENCRYPTION_KEY=

API_SECRET_JWT=
API_JWT_EXPIRED=5minutes
API_SECRET_REFRESH=
API_REFRESH_EXPIRED=6months
API_COOKIE_NAME=travelBliss
