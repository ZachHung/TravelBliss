# Committed: the throwaway e2e stack (pnpm e2e) with dummy values, never a real secret.
# Its own compose project and ports, so it runs beside `pnpm dev:local` without touching its data.
COMPOSE_PROJECT_NAME=travelbliss-e2e

VITE_GRAPHQL_URI=http://localhost:8001

API_PORT=8001
API_LOG_LEVEL=warn
API_CORS_ORIGIN=http://localhost:5174
API_PUBLIC_URL=http://localhost:8001

API_POSTGRES_HOST=localhost
API_POSTGRES_PORT=5433
API_POSTGRES_USER=e2e
API_POSTGRES_PASSWORD=e2e
API_POSTGRES_DB=travelbliss
API_POSTGRES_SSL=false

API_REDIS_PORT=6380
API_REDIS_PASSWORD=e2e
API_REDIS_URI=redis://default:e2e@localhost:6380

API_SALT_ROUND=4
API_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
API_SECRET_JWT=e2e
API_JWT_EXPIRED=5m
API_SECRET_REFRESH=e2e
API_REFRESH_EXPIRED=1d
API_SESSION_MAX_AGE=7d
API_COOKIE_NAME=travelBliss
