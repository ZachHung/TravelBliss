{
  "name": "travel-bliss-backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:dev": "pnpm exec ts-node-dev --respawn src/index.ts",
    "start:prod": "NODE_ENV=production pnpm exec ts-node-dev --respawn src/index.ts",
    "docker:local:up": "docker-compose -f infra/docker-compose-local.yml up",
    "docker:local:down": "docker-compose -f infra/docker-compose-local.yml down",
    "docker:serve:up": "docker-compose -f infra/docker-compose-serve.yml up",
    "docker:serve:down": "docker-compose -f infra/docker-compose-serve.yml down",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm lint:eslint",
    "lint:eslint": "eslint . --ext .ts,.tsx --cache",
    "prettier": "prettier --check \"**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
    "typeorm": "pnpm exec typeorm-ts-node-commonjs -d ./dist/config/data-source.js",
    "migration:generate": "pnpm typeorm migration:generate ./src/migration/migration",
    "migration:up": "pnpm typeorm migration:run",
    "migration:down": "pnpm typeorm migration:revert",
    "test": "pnpm typecheck && pnpm prettier && pnpm lint && pnpm vitest && pnpm build",
    "vitest": "vitest run",
    "test:watch": "vitest --reporter verbose",
    "preinstall": "npx only-allow pnpm"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express4": "^1.1.2",
    "bcrypt": "^6.0.0",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "graphql": "^16.15.0",
    "inversify": "^6.2.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "type-graphql": "2.0.0-beta.3",
    "typeorm": "^0.3.31",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
