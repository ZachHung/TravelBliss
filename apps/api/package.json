{
  "name": "@travelbliss/api",
  "private": true,
  "version": "1.0.0",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "start": "node dist/index.js",
    "build": "vite build",
    "schema": "node -r reflect-metadata dist/schema.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache",
    "test": "vitest run",
    "test:watch": "vitest --reporter verbose",
    "docker:local:up": "docker compose --env-file ../../.env.local -f infra/docker-compose.yml up",
    "docker:local:down": "docker compose --env-file ../../.env.local -f infra/docker-compose.yml down",
    "docker:serve:up": "docker compose --env-file ../../.env.local -f infra/docker-compose.yml --profile serve up --build",
    "docker:serve:down": "docker compose --env-file ../../.env.local -f infra/docker-compose.yml --profile serve down",
    "typeorm": "pnpm build && typeorm -d ./dist/config/data-source.js",
    "migration:generate": "pnpm typeorm migration:generate ./src/migration/migration",
    "migration:check": "pnpm typeorm migration:generate ./src/migration/migration --check",
    "migration:up": "pnpm typeorm migration:run",
    "migration:down": "pnpm typeorm migration:revert"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/express5": "^1.1.2",
    "arctic": "3.7.0",
    "bcrypt": "^6.0.0",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "graphql": "^16.15.0",
    "graphql-scalars": "^1.26.0",
    "inversify": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "type-graphql": "2.0.0-rc.3",
    "typeorm": "^1.1.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "2.1.0",
    "@vitest/coverage-v8": "^5.1.1",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
