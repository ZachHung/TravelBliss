{
  "name": "@travelbliss/api",
  "private": true,
  "version": "1.0.0",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn src/index.ts",
    "start": "node dist/index.js",
    "build": "vite build",
    "schema": "node -r reflect-metadata dist/schema.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache",
    "test": "vitest run",
    "test:watch": "vitest --reporter verbose",
    "docker:local:up": "docker compose --env-file ../../.env.local -f infra/docker-compose.yml up",
    "docker:local:down": "docker compose --env-file ../../.env.local -f infra/docker-compose.yml down",
    "docker:serve:up": "docker compose --env-file ../../.env.local -f infra/docker-compose.yml --profile serve up --build",
    "docker:serve:down": "docker compose --env-file ../../.env.local -f infra/docker-compose.yml --profile serve down",
    "typeorm": "pnpm build && typeorm-ts-node-commonjs -d ./dist/config/data-source.js",
    "migration:generate": "pnpm typeorm migration:generate ./src/migration/migration",
    "migration:up": "pnpm typeorm migration:run",
    "migration:down": "pnpm typeorm migration:revert"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express4": "^1.1.2",
    "bcrypt": "^6.0.0",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "graphql": "^16.15.0",
    "inversify": "^6.2.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "type-graphql": "2.0.0-beta.3",
    "typeorm": "^0.3.31",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
