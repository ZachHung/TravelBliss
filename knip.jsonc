{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/api": {
      // TypeORM loads migrations by glob; `pnpm schema` runs the built schema.ts; deploy.sh runs check-env.ts (#215)
      "entry": ["src/index.ts", "src/schema.ts", "src/config/check-env.ts", "src/migration/*.ts"],
    },
    "apps/web": {
      // Imported by the generated codegen output, which is git-ignored
      "ignoreDependencies": ["@graphql-typed-document-node/core"],
    },
  },
  // The teaching course: static HTML pages that load their scripts with <script> tags
  "ignore": ["lessons/**"],
  // System tools used by `pnpm dev:stop`
  "ignoreBinaries": ["pkill"],
}
